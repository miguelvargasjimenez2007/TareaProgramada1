# de una ruta de como máximo 3 aristas. Los nodos que se encuentran más lejos
# del nodo raíz se omitirán. Tenga en cuenta que configurar esta opción en 1 o 2
# puede reducir en gran medida el tiempo de computación necesario para bases de
# código grandes. Tenga en cuenta también que el tamaño de un grafo puede estar
# más limitado por DOT_GRAPH_MAX_NODES. Usar una profundidad de 0 significa sin
# límite de profundidad.
# Valor mínimo: 0, valor máximo: 1000, valor predeterminado: 0.
# Esta etiqueta requiere que la etiqueta HAVE_DOT esté establecida en YES.

MAX_DOT_GRAPH_DEPTH    = 0

