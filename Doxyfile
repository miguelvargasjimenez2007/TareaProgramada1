# Doxyfile 1.18.0

# Este archivo describe la configuración que utilizará el sistema de
# documentación Doxygen (www.doxygen.org) para un proyecto.
#
# Todo el texto que sigue a una doble almohadilla (##) se considera un
# comentario y se coloca delante de la etiqueta a la que precede.
#
# Todo el texto que sigue a una única almohadilla (#) se considera un
# comentario y será ignorado. El formato es:
# TAG = value [value, ...]
# Para las listas, los elementos también se pueden añadir usando:
# TAG += value [value, ...]
# Los valores que contienen espacios deben colocarse entre comillas (" ").
#
# Nota:
#
# Use Doxygen para comparar el archivo de configuración utilizado con el
# archivo de configuración de plantilla:
# doxygen -x [configFile]
# Use Doxygen para comparar el archivo de configuración utilizado con el
# archivo de configuración de plantilla sin reemplazar las variables de entorno
# o las variables de reemplazo de tipo CMake:
# doxygen -x_noenv [configFile]

#---------------------------------------------------------------------------
# Opciones de configuración relacionadas con el proyecto
#---------------------------------------------------------------------------

# Esta etiqueta especifica la codificación de todos los caracteres en el archivo
# de configuración que sigue. El valor predeterminado es UTF-8, que también es
# la codificación para todo el texto antes de la primera aparición de esta
# etiqueta. Doxygen usa libiconv (o iconv incorporado en libc) para la
# transcodificación. Ver https://www.gnu.org/software/libiconv/ para la lista de
# posibles codificaciones.
# El valor predeterminado es: UTF-8.

DOXYFILE_ENCODING      = UTF-8

# La etiqueta PROJECT_NAME es una sola palabra (o una secuencia de palabras
# rodeadas de comillas dobles, a menos que esté usando Doxywizard) que debe
# identificar el proyecto para el cual se genera la documentación. Este nombre
# se usa en el título de la mayoría de las páginas generadas y en algunos otros
# lugares.
# El valor predeterminado es: My Project.

PROJECT_NAME           = "My Project"

# La etiqueta PROJECT_NUMBER se puede usar para ingresar un número de proyecto o
# revisión. Esto puede ser útil para archivar la documentación generada o si se
# usa algún sistema de control de versiones.

PROJECT_NUMBER         =

# Usando la etiqueta PROJECT_BRIEF se puede proporcionar una descripción
# opcional de una línea para un proyecto que aparece en la parte superior de
# cada página y debe dar a los espectadores una idea rápida sobre el propósito
# del proyecto. Mantenga la descripción corta.

PROJECT_BRIEF          = "Tarea Programada I"

# Con la etiqueta PROJECT_LOGO se puede especificar un logotipo o icono que se
# incluye en la documentación. La altura máxima del logotipo no debe exceder los
# 55 píxeles y el ancho máximo no debe exceder los 200 píxeles. Doxygen copiará
# el logotipo en el directorio de salida.

PROJECT_LOGO           =

# Con la etiqueta PROJECT_ICON se puede especificar un icono que se incluye en
# las pestañas cuando se muestra el documento HTML. Doxygen copiará el logotipo
# en el directorio de salida.

PROJECT_ICON           =

# La etiqueta OUTPUT_DIRECTORY se usa para especificar la ruta (relativa o
# absoluta) donde se escribirá la documentación generada. Si se ingresa una ruta
# relativa, es relativa a la ubicación desde donde se inició Doxygen. Si se deja
# vacío, se usará el directorio actual.

OUTPUT_DIRECTORY       = "C:/Users/User/Downloads/Tarea Progamada I"

# Si la etiqueta CREATE_SUBDIRS está configurada en YES, Doxygen creará hasta
# 4096 subdirectorios (en 2 niveles) bajo el directorio de salida de cada
# formato de salida y distribuirá los archivos generados en estos directorios.
# Habilitar esta opción puede ser útil cuando se alimenta a Doxygen con una gran
# cantidad de archivos fuente, donde colocar todos los archivos generados en el
# mismo directorio causaría problemas de rendimiento para el sistema de
# archivos. Ajuste CREATE_SUBDIRS_LEVEL para controlar el número de
# subdirectorios.
# El valor predeterminado es: NO.

CREATE_SUBDIRS         = NO

# Controla el número de subdirectorios que se crean cuando la etiqueta
# CREATE_SUBDIRS está configurada en YES. El nivel 0 representa 16 directorios,
# y cada aumento de nivel duplica el número de directorios, resultando en 4096
# directorios en el nivel 8, que es el valor predeterminado y también el valor
# máximo. Los subdirectorios están organizados en 2 niveles, donde el primer
# nivel siempre tiene un número fijo de 16 directorios.
# Valor mínimo: 0, valor máximo: 8, valor predeterminado: 8.
# Esta etiqueta requiere que la etiqueta CREATE_SUBDIRS esté establecida en YES.

CREATE_SUBDIRS_LEVEL   = 8

# Si la etiqueta ALLOW_UNICODE_NAMES está configurada en YES, Doxygen permitirá
# caracteres no ASCII en los nombres de los archivos generados. Si se configura
# en NO, los caracteres no ASCII serán escapados, por ejemplo _xE3_x81_x84 para
# Unicode U+3044.
# El valor predeterminado es: NO.

ALLOW_UNICODE_NAMES    = NO

# La etiqueta OUTPUT_LANGUAGE se usa para especificar el idioma en el que se
# escribe toda la documentación generada por Doxygen. Doxygen usará esta
# información para generar toda la salida constante en el idioma apropiado.
# Los valores posibles son:Afrikaans, Arabic, Armenian, Brazilian, Bulgarian,
# Catalan, Chinese, Chinese-Traditional, Croatian, Czech, Danish, Dutch, English
# (Estados Unidos), Esperanto, Farsi (Persa), Finnish, French, German, Greek,
# Hindi, Hungarian, Indonesian, Italian, Japanese, Japanese-en (Japonés con
# mensajes en inglés), Korean, Korean-en (Coreano con mensajes en inglés),
# Latvian, Lithuanian, Macedonian, Norwegian, Persian (Farsi), Polish,
# Portuguese, Romanian, Russian, Serbian, Serbian-Cyrillic, Slovak, Slovene,
# Spanish, Swedish, Turkish, UkrainianyVietnamese.
# El valor predeterminado es: English.

OUTPUT_LANGUAGE        = English

# Si la etiqueta BRIEF_MEMBER_DESC está configurada en YES, Doxygen incluirá
# descripciones breves de los miembros después de los miembros que se enumeran
# en la documentación de archivos y clases (similar a Javadoc). Configure en NO
# para desactivar esto.
# El valor predeterminado es: YES.

BRIEF_MEMBER_DESC      = YES

# Si la etiqueta REPEAT_BRIEF está configurada en YES, Doxygen antepondrá la
# descripción breve de un miembro o función antes de la descripción detallada.
#
# Nota: Si tanto HIDE_UNDOC_MEMBERS como BRIEF_MEMBER_DESC están configurados en
# NO, las descripciones breves se suprimirán por completo.
# El valor predeterminado es: YES.

REPEAT_BRIEF           = YES

# Esta etiqueta implementa un abreviador de descripción breve casi inteligente
# que se usa para formar el texto en varias listas. Cada cadena en esta lista,
# si se encuentra como el texto inicial de una descripción breve, se eliminará
# del texto, y el resultado después de procesar toda la lista se usará como el
# texto anotado. De lo contrario, se usará la descripción breve como se
# especificó. Si se deja vacío, se usarán los siguientes valores ($name se
# reemplaza automáticamente por el nombre de la entidad):The $name class, The
# $name widget, The $name file, is, provides, specifies, contains, represents,
# a, anythe.

ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the

# Si las etiquetas ALWAYS_DETAILED_SEC y REPEAT_BRIEF están configuradas en YES,
# Doxygen generará una sección detallada incluso si solo hay una descripción
# breve.
# El valor predeterminado es: NO.

ALWAYS_DETAILED_SEC    = NO

# Si la etiqueta INLINE_INHERITED_MEMB está configurada en YES, Doxygen mostrará
# todos los miembros heredados de una clase en la documentación de esa clase
# como si esos miembros fueran miembros normales de la clase. Los constructores,
# destructores y operadores de asignación de las clases base no se mostrarán.
# El valor predeterminado es: NO.

INLINE_INHERITED_MEMB  = NO

# Si la etiqueta FULL_PATH_NAMES está configurada en YES, Doxygen antepondrá la
# ruta completa antes de los nombres de archivo en la lista de archivos y en los
# archivos de encabezado. Si se configura en NO, se usará la ruta más corta que
# haga que los nombres de archivo sean únicos.
# El valor predeterminado es: YES.

FULL_PATH_NAMES        = YES

# La etiqueta STRIP_FROM_PATH se puede usar para eliminar una parte definida por
# el usuario de la ruta. La eliminación solo se hace si una de las cadenas
# especificadas coincide con la parte izquierda de la ruta. La etiqueta se puede
# usar para mostrar rutas relativas en la lista de archivos. Si se deja vacío,
# el directorio desde donde se ejecuta Doxygen se usa como la ruta a eliminar.
#
# Tenga en cuenta que puede especificar rutas absolutas aquí, pero también rutas
# relativas, que serán relativas al directorio donde se inició Doxygen.
# Esta etiqueta requiere que la etiqueta FULL_PATH_NAMES esté establecida en
# YES.

STRIP_FROM_PATH        =

# La etiqueta STRIP_FROM_INC_PATH se puede usar para eliminar una parte definida
# por el usuario de la ruta mencionada en la documentación de una clase, que le
# dice al lector que archivo de encabezado incluir para usar una clase. Si se
# deja vacío, solo se usará el nombre del archivo de encabezado que contiene la
# definición de la clase. De lo contrario, se debe especificar la lista de rutas
# de inclusión que normalmente se pasan al compilador usando la bandera -I.

STRIP_FROM_INC_PATH    =

# Si la etiqueta SHORT_NAMES está configurada en YES, Doxygen generará nombres
# de archivo cortos (pero no únicos). Esto puede ser útil si su sistema de
# archivos no soporta nombres largos, como DOS, Mac o CD-ROM.
# El valor predeterminado es: NO.

SHORT_NAMES            = NO

# Si la etiqueta JAVADOC_AUTOBRIEF está configurada en YES, Doxygen interpretará
# la primera línea (hasta el primer punto, signo de interrogación o signo de
# exclamación) de un comentario estilo Javadoc como la descripción breve. Si se
# configura en NO, el estilo Javadoc se comportara como comentarios de estilo Qt
# normales (por lo que se requiere un comando @brief explícito para una
# descripción breve).
# El valor predeterminado es: NO.

JAVADOC_AUTOBRIEF      = NO

# Si la etiqueta JAVADOC_BANNER está configurada en YES, Doxygen interpretará
# una línea como
# /***************
# como el comienzo de un banner de comentario estilo Javadoc. Si se configura
# en NO, el estilo Javadoc se comportara como comentarios normales y no será
# interpretado por Doxygen.
# El valor predeterminado es: NO.

JAVADOC_BANNER         = NO

# Si la etiqueta QT_AUTOBRIEF está configurada en YES, Doxygen interpretará la
# primera línea (hasta el primer punto, signo de interrogación o signo de
# exclamación) de un comentario estilo Qt como la descripción breve. Si se
# configura en NO, el estilo Qt se comportara como comentarios estilo Qt
# normales (por lo que se requiere un comando \brief explícito para una
# descripción breve).
# El valor predeterminado es: NO.

QT_AUTOBRIEF           = NO

# La etiqueta MULTILINE_CPP_IS_BRIEF se puede configurar en YES para hacer que
# Doxygen trate un bloque de comentario especial de C++ multilinea (es decir, un
# bloque de comentarios //! o ///) como una descripción breve. Este era el
# comportamiento predeterminado anteriormente. El nuevo valor predeterminado es
# tratar un bloque de comentarios de C++ multilinea como una descripción
# detallada. Configure esta etiqueta en YES si prefiere el comportamiento
# anterior.
#
# Tenga en cuenta que configurar esta etiqueta en YES también significa que los
# comentarios de Rational Rose ya no serán reconocidos.
# El valor predeterminado es: NO.

MULTILINE_CPP_IS_BRIEF = NO

# Por defecto, los docstrings de Python se muestran como texto preformateado y
# no se pueden usar los comandos especiales de Doxygen. Al configurar
# PYTHON_DOCSTRING en NO, se pueden usar los comandos especiales de Doxygen y el
# contenido de los bloques de documentación de docstrings se muestra como
# documentación de Doxygen.
# El valor predeterminado es: YES.

PYTHON_DOCSTRING       = YES

# Si la etiqueta INHERIT_DOCS está configurada en YES, un miembro no documentado
# heredara la documentación de cualquier miembro documentado que reimplemente.
# El valor predeterminado es: YES.

INHERIT_DOCS           = YES

# Si la etiqueta SEPARATE_MEMBER_PAGES está configurada en YES, Doxygen generará
# una página separada para cada miembro. Si se configura en NO, la documentación
# de todos los miembros de un compuesto (clase, archivo, espacio de nombres) se
# combinará en un solo documento.
# El valor predeterminado es: NO.

SEPARATE_MEMBER_PAGES  = NO

# La etiqueta TAB_SIZE se puede usar para establecer el número de espacios en
# una tabulación. Doxygen usa este valor para reemplazar las tabulaciones por
# espacios en los fragmentos de código.
# Valor mínimo: 1, valor máximo: 16, valor predeterminado: 4.

TAB_SIZE               = 4

# Esta etiqueta se puede usar para especificar varios alias que actuen como
# comandos en la documentación. Un alias tiene la forma:
# nombre=valor
# Por ejemplo, agregar
# "sideeffect=@par Efectos secundarios:^^"
# le permitirá colocar el comando \sideeffect (o @sideeffect) en la
# documentación, lo que resultará en un párrafo definido por el usuario con el
# encabezado "Efectos secundarios:". Tenga en cuenta que no puede poner \n en el
# valor de un alias para insertar un salto de línea (en la salida resultante).
# Puede poner ^^ en el valor de un alias para insertar un salto de línea como si
# hubiera un salto de línea físico en el archivo original.Cuando necesites usar
# literalmente {, } o , en el valor de un alias, debes escaparlos con una barra
# invertida (\). Esto puede generar conflictos con los comandos \{ y \}. Para
# estos últimos, se recomienda usar la versión @{ y @} o usar una doble
# secuencia de escape (\\{ y \\}).

ALIASES                =

# Configure la etiqueta OPTIMIZE_OUTPUT_FOR_C en YES si su proyecto consiste
# solo en fuentes C. Doxygen generará una salida más adaptada a C. Por ejemplo,
# algunos de los nombres usados serán diferentes. La lista de todos los miembros
# se omitirá, etc.
# El valor predeterminado es: NO.

OPTIMIZE_OUTPUT_FOR_C  = NO

# Configure la etiqueta OPTIMIZE_OUTPUT_JAVA en YES si su proyecto consiste solo
# en fuentes Java o Python. Doxygen generará una salida más adaptada a ese
# lenguaje. Por ejemplo, los espacios de nombres se presentarán como paquetes,
# los ámbitos calificados se verán diferentes, etc.
# El valor predeterminado es: NO.

OPTIMIZE_OUTPUT_JAVA   = YES

# Configure la etiqueta OPTIMIZE_FOR_FORTRAN en YES si su proyecto consiste en
# fuentes Fortran. Doxygen generará una salida adaptada a Fortran.
# El valor predeterminado es: NO.

OPTIMIZE_FOR_FORTRAN   = NO

# Configure la etiqueta OPTIMIZE_OUTPUT_VHDL en YES si su proyecto consiste en
# fuentes VHDL. Doxygen generará una salida adaptada a VHDL.
# El valor predeterminado es: NO.

OPTIMIZE_OUTPUT_VHDL   = NO

# Configure la etiqueta OPTIMIZE_OUTPUT_SLICE en YES si su proyecto consiste
# solo en fuentes Slice. Doxygen generará una salida más adaptada a ese
# lenguaje. Por ejemplo, los espacios de nombres se presentarán como módulos,
# los tipos se agruparán en más grupos, etc.
# El valor predeterminado es: NO.

OPTIMIZE_OUTPUT_SLICE  = NO

# Doxygen selecciona el analizador a usar basándose en la extensión del archivo
# a analizar. Con esta etiqueta puede asignar un analizador para usar con una
# extensión dada. Doxygen tiene un mapeo incorporado, pero puede anularlo o
# extenderlo con esta etiqueta. El formato es ext=language, donde ext es una
# extensión de archivo y language es uno de los analizadores soportados por
# Doxygen: IDL, Java, JavaScript, Csharp (C#), C, C++, Lex, D, PHP, md
# (Markdown), Objective-C, Python, Slice, VHDL, Fortran (Fortran de formato
# fijo: FortranFixed, Fortran de formato libre: FortranFree, Fortran de formato
# desconocido: Fortran. En este último caso, el analizador intentará adivinar si
# el código es de formato fijo o libre, que es el valor predeterminado para
# archivos de tipo Fortran). Por ejemplo, para hacer que Doxygen trate los
# archivos .inc como archivos Fortran (el valor predeterminado es PHP) y los
# archivos .f como C (el valor predeterminado es Fortran), use: inc=Fortran f=C.
#
# Nota: Para archivos sin extensión, puede usar no_extension como comodín.
#
# Nota: Cuando se especifica no_extension, también debe agregar * a
# FILE_PATTERNS.
#
# Nota: Para extensiones personalizadas, también debe configurar FILE_PATTERNS,
# de lo contrario los archivos no serán leidos por Doxygen.
#
# Nota: Vea también la lista de mapeos de extensiones de archivo
# predeterminados.

EXTENSION_MAPPING      =

# Si la etiqueta MARKDOWN_SUPPORT está habilitada, Doxygen preprocesará todos
# los comentarios de acuerdo con el formato Markdown, lo que permite una
# documentación más legible. Vea https://daringfireball.net/projects/markdown/
# para detalles. La salida del procesamiento de Markdown es procesada
# posteriormente por Doxygen, por lo que puede mezclar comandos de Doxygen, HTML
# y XML con formato Markdown. Deshabilite esto solo si tiene problemas con la
# compatibilidad hacia atras.
# El valor predeterminado es: YES.

MARKDOWN_SUPPORT       = YES

# Si la etiqueta MARKDOWN_STRICT está habilitada, Doxygen tratará el texto en
# los comentarios como Markdown formateado también en casos donde el formato de
# marcado nativo de Doxygen entra en conflicto con el de Markdown. Esto solo es
# relevante en casos donde se usan acentos graves. El estilo de marcado nativo
# de Doxygen permite que una comilla simple termine un fragmento de texto que
# comenzo con un acento grave y luego tratarlo como un fragmento de texto
# citado, mientras que en Markdown tal fragmento de texto se trata como literal
# y solo termina cuando se encuentra un segundo acento grave coincidente.
# Además, el formato de marcado nativo de Doxygen requiere que las comillas
# dobles se escapen cuando aparecen en una sección de acentos graves, mientras
# que esto no es necesario para Markdown.
# El valor predeterminado es: YES.
# Esta etiqueta requiere que la etiqueta MARKDOWN_SUPPORT esté establecida en
# YES.

MARKDOWN_STRICT        = YES

# Cuando la etiqueta TOC_INCLUDE_HEADINGS está configurada en un valor no nulo,
# todos los encabezados hasta ese nivel se incluyen automáticamente en la tabla
# de contenidos, incluso si no tienen un atributo id.
# Nota: Esta función actualmente se aplica solo a los encabezados de Markdown.
# Valor mínimo: 0, valor máximo: 99, valor predeterminado: 6.
# Esta etiqueta requiere que la etiqueta MARKDOWN_SUPPORT esté establecida en
# YES.

TOC_INCLUDE_HEADINGS   = 6

# La etiqueta MARKDOWN_ID_STYLE se puede usar para especificar el algoritmo
# utilizado para generar identificadores para los encabezados de Markdown. Nota:
# Cada identificador es único.
# Los valores posibles son:DOXYGEN usar una cadena 'autotoc_md' fija seguida de
# un número de secuencia comenzando en 0yGITHUB usar la versión en minúsculas
# del título con cualquier espacio en blanco reemplazado por '-' y caracteres de
# puntuación eliminados.
# El valor predeterminado es: DOXYGEN.
# Esta etiqueta requiere que la etiqueta MARKDOWN_SUPPORT esté establecida en
# YES.

MARKDOWN_ID_STYLE      = DOXYGEN

# Si está habilitado, Doxygen intentará vincular palabras que correspondan a una
# clase o espacio de nombres documentado con la documentación correspondiente.
# Esto se puede evitar en casos individuales colocando un símbolo % antes de la
# palabra, o globalmente configurando AUTOLINK_SUPPORT en NO. Las palabras
# listadas en la etiqueta AUTOLINK_IGNORE_WORDS serán excluidas de la
# vinculación automática.
# El valor predeterminado es: YES.

AUTOLINK_SUPPORT       = YES

# Esta etiqueta especifica una lista de palabras que, cuando coinciden con el
# comienzo de una palabra en la documentación, suprimirán la generación
# automática de enlaces cuando esta está habilitada por AUTOLINK_SUPPORT. Esta
# lista no afecta los enlaces creados explícitamente con # o los comandos \link
# o \ref.
# Esta etiqueta requiere que la etiqueta AUTOLINK_SUPPORT esté establecida en
# YES.

AUTOLINK_IGNORE_WORDS  =

# Si usa clases STL (es decir, std::string, std::vector, etc.), pero no incluye
# el código fuente (archivo de etiquetas) de la STL como entrada, debe
# configurar esta etiqueta en YES para que Doxygen pueda hacer coincidir
# declaraciones y definiciones de funciones con argumentos que contienen clases
# STL (por ejemplo, func(std::string); versus func(std::string) {}). Esto
# también hace que los diagramas de herencia y colaboración que involucran
# clases STL sean más completos y precisos.
# El valor predeterminado es: NO.

BUILTIN_STL_SUPPORT    = NO

# Si usa el lenguaje C++/CLI de Microsoft, debe configurar esta opción en YES
# para habilitar el soporte de análisis.
# El valor predeterminado es: NO.

CPP_CLI_SUPPORT        = NO

# Configure la etiqueta SIP_SUPPORT en YES si su proyecto consiste solo en
# fuentes [sip]. Doxygen las analizará como C++ normal pero asumirá que todas
# las clases usan herencia pública en lugar de privada cuando no se presenta
# ninguna palabra clave de protección explícita.
# El valor predeterminado es: NO.

SIP_SUPPORT            = NO

# Para el IDL de Microsoft, existen los atributos propget y propput para indicar
# métodos getter y setter para una propiedad. Configurar esta opción en YES hará
# que Doxygen reemplace los métodos get y set en la documentación con la
# propiedad. Esto solo funciona si los métodos realmente obtienen o establecen
# un tipo simple. Si este no es el caso o si desea mostrar los métodos de todos
# modos, debe configurar esta opción en NO.
# El valor predeterminado es: YES.

IDL_PROPERTY_SUPPORT   = YES

# Si se usa la agrupación de miembros en la documentación y la etiqueta
# DISTRIBUTE_GROUP_DOC está configurada en YES, Doxygen reutilizara la
# documentación del primer miembro del grupo para los otros miembros del grupo
# (si los hay). Por defecto, todos los miembros de un grupo deben estar
# documentados explícitamente.
# El valor predeterminado es: NO.

DISTRIBUTE_GROUP_DOC   = NO

# Cuando una estructura o clase se agrega a un grupo y esta opción está
# habilitada, todas las clases o estructuras anidadas también se agregarán al
# mismo grupo. Por defecto, esta opción está deshabilitada y uno debe agregar
# entidades anidadas explícitamente a través de \ingroup.
# El valor predeterminado es: NO.

GROUP_NESTED_COMPOUNDS = NO

# Configure la etiqueta SUBGROUPING en YES para permitir que los grupos de
# miembros de clase del mismo tipo (por ejemplo, un grupo de funciones públicas)
# se coloquen como un subgrupo de ese tipo (por ejemplo, bajo la sección
# Funciones Públicas). Configúrelo en NO para evitar la subagrupación.
# Alternativamente, esto se puede hacer por clase usando el comando
# \nosubgrouping.
# El valor predeterminado es: YES.

SUBGROUPING            = YES

# Si la etiqueta INLINE_GROUPED_CLASSES está configurada en YES, las clases,
# estructuras y uniones se mostrarán dentro del grupo en el que están contenidas
# (por ejemplo, con \ingroup) en lugar de en una página separada (para HTML y
# páginas de manual) o en una sección (para LaTeX y RTF).
#
# Tenga en cuenta que esta función no funciona en combinación con
# SEPARATE_MEMBER_PAGES.
# El valor predeterminado es: NO.

INLINE_GROUPED_CLASSES = NO

# Si la etiqueta INLINE_SIMPLE_STRUCTS está configurada en YES, las estructuras,
# clases y uniones con solo campos de datos públicos o campos typedef simples se
# mostrarán en línea en la documentación del ámbito en el que están definidas
# (es decir, documentación de archivo, espacio de nombres o grupo), siempre que
# dicho ámbito este documentado. Si se configura en NO, las estructuras, clases
# y uniones se mostrarán en una página separada (para HTML y páginas de manual)
# o en una sección (para LaTeX y RTF).
