# comportara como FAIL_ON_WARNINGS pero en caso de que no se defina
# WARN_LOGFILE, Doxygen no escribirá los mensajes de advertencia entre otros
# mensajes sino que los escribirá al final de una ejecución. En caso de que se
# defina WARN_LOGFILE, los mensajes de advertencia además de estar en el archivo
# definido también se mostrarán al final de una ejecución, a menos que
# WARN_LOGFILE se defina como -, es decir, salida estándar (stdout), en ese caso
# el comportamiento seguirá siendo como con la configuración FAIL_ON_WARNINGS.
# Los valores posibles son:NO, YES, FAIL_ON_WARNINGSyFAIL_ON_WARNINGS_PRINT.
# El valor predeterminado es: NO.

WARN_AS_ERROR          = NO

# La etiqueta WARN_FORMAT determina el formato de los mensajes de advertencia
# que Doxygen puede producir. La cadena debe contener las etiquetas $file, $line
# y $text, que serán reemplazadas por el archivo y número de línea desde donde
# se origino la advertencia y el texto de la advertencia. Opcionalmente, el
# formato puede contener $versión, que será reemplazado por la versión del
# archivo (si se pudo obtener a través de FILE_VERSION_FILTER).
# Ver también: WARN_LINE_FORMAT
# El valor predeterminado es: $file:$line: $text.

WARN_FORMAT            = "$file:$line: $text"

# En la parte $text del comando WARN_FORMAT, es posible que se proporcione una
# referencia a un lugar más específico. Para facilitar el salto a este lugar
# (fuera de Doxygen), el usuario puede definir una cadena personalizada de
# "cortar"/"pegar". Ejemplo:
# WARN_LINE_FORMAT = "'vi $file +$line'"
# Ver también: WARN_FORMAT
# El valor predeterminado es: at line $line of file $file.

WARN_LINE_FORMAT       = "at line $line of file $file"

# La etiqueta WARN_LOGFILE se puede usar para especificar un archivo en el que
# se deben escribir los mensajes de advertencia y error. Si se deja vacío, la
# salida se escribe en el error estándar (stderr). En caso de que el archivo
# especificado no se pueda abrir para escritura, los mensajes de advertencia y
# error se escriben en el error estándar. Cuando se especifica el archivo -, los
# mensajes de advertencia y error se escriben en la salida estándar (stdout).

WARN_LOGFILE           =

